<?xml version="1.0" encoding="utf-8"?>
<!--
  jpackage's main.wxs template from JDK 21 (jdk.jpackage/internal/resources/main.wxs), with PSD2Live
  changes marked "PSD2Live". jpackage reads it from the resource directory build.gradle.kts passes; keep
  it in step with the template of the JDK that packages the app.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif?>

  <!-- PSD2Live: a new product code for every build, so a package of the same version (a rebuild, or the
       build with or without ffmpeg) replaces the installed one instead of opening its maintenance mode. -->
  <Product
    Id="*"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="yes" /><!-- PSD2Live: the same version is replaced too, never installed beside it. -->
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif?>

    <Binary Id="JpCaDll" SourceFile="wixhelper.dll"/>

    <CustomAction Id="JpFindRelatedProducts" BinaryKey="JpCaDll" DllEntry="FindRelatedProductsEx" />

    <!-- Standard required root -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
      <ComponentRef Id="PSD2LiveInstallDir"/><!-- PSD2Live -->
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <UIRef Id="JpUI"/>

    <!-- PSD2Live: install where the installed version is, so an upgrade or reinstall needs no folder
         choice. The folder is recorded under the vendor's key; installs from before that record are
         found through the launcher's component, whose GUID jpackage derives from its path. -->
    <?ifdef JpIsSystemWide ?>
      <?define PSD2LiveRegistryRoot="HKLM"?>
    <?else?>
      <?define PSD2LiveRegistryRoot="HKCU"?>
    <?endif?>
    <Property Id="PSD2LIVE_PREVIOUS_DIR">
      <RegistrySearch Id="PSD2LiveRecordedDir" Root="$(var.PSD2LiveRegistryRoot)" Key="Software\$(var.JpAppVendor)\$(var.JpAppName)"
        Name="InstallDir" Type="directory" Win64="yes"/>
    </Property>
    <Property Id="PSD2LIVE_LAUNCHER_DIR">
      <ComponentSearch Id="PSD2LiveLauncherDir" Guid="{da799de4-3322-3443-8085-6110b1356389}" Type="directory"/>
    </Property>
    <SetProperty Action="PSD2LiveLegacyDir" Id="PSD2LIVE_PREVIOUS_DIR" Value="[PSD2LIVE_LAUNCHER_DIR]" After="AppSearch"
      Sequence="both">NOT PSD2LIVE_PREVIOUS_DIR AND PSD2LIVE_LAUNCHER_DIR</SetProperty>
    <!-- In the UI sequence when there is one, so the folder chosen in the dialog stands. Also when installed:
         a per-user install's components have registry key paths, so its uninstall cannot find the folder
         otherwise and would remove files from the default one. -->
    <SetDirectory Id="INSTALLDIR" Value="[PSD2LIVE_PREVIOUS_DIR]" Sequence="first">PSD2LIVE_PREVIOUS_DIR</SetDirectory>
    <SetProperty Action="PSD2LivePreviousInstallDir" Id="PSD2LIVE_PREVIOUS_INSTALLDIR" Value="[INSTALLDIR]" After="CostFinalize"
      Sequence="ui">PSD2LIVE_PREVIOUS_DIR AND NOT Installed</SetProperty>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PSD2LiveInstallDir" Guid="{442B6066-FA33-4114-B35A-6D2D89F00154}" Win64="yes">
        <!-- PSD2Live: clears what earlier versions recorded under the app's key (rewritten below), above all the
             folder their uninstall empties; see PSD2LiveKeepFolder. -->
        <RemoveRegistryKey Root="HKMU" Key="Software\$(var.JpAppVendor)\$(var.JpAppName)" Action="removeOnInstall"/>
        <RegistryValue Root="HKMU" Key="Software\$(var.JpAppVendor)\$(var.JpAppName)" Name="InstallDir" Type="string"
          Value="[INSTALLDIR]" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- PSD2Live: jpackage records the install folder under the version's key (RM_RF..., the property
         build.gradle.kts checks the generated sources for) and its RemoveFolderEx deletes that folder with
         everything in it on uninstall, files the user put there included. Without the property it removes
         only what it installed. Earlier versions do this too and their uninstall runs from their own package,
         so it runs after this package is in place (RemoveExistingProducts below), once the registry key above
         has lost what they recorded; every file is written so that order leaves no file of theirs behind. -->
    <SetProperty Action="PSD2LiveKeepFolder" Id="RM_RF48431AECBD69377EA800D62616352F20" Value="[PSD2LIVE_NO_VALUE]" After="AppSearch"
      Sequence="both"/>
    <Property Id="REINSTALLMODE" Value="amus"/>
    <UI>
      <!-- The installed version's folder is not empty, but replacing it is what an upgrade does: skip the
           "folder is not empty" question there (JpCheckInstallDir runs at 3, the next dialog opens at 5). -->
      <Publish Dialog="InstallDirDlg" Control="Next" Property="INSTALLDIR_VALID" Value="1" Order="4">PSD2LIVE_PREVIOUS_INSTALLDIR AND INSTALLDIR ~= PSD2LIVE_PREVIOUS_INSTALLDIR</Publish>

      <!-- PSD2Live: Remove in the maintenance dialog asks whether to delete the user's data as well (the
           strings are in PSD2LiveStrings.wxl). These NewDialog events come last, so they win over WixUI's. -->
      <Dialog Id="PSD2LiveRemoveDataDlg" Width="370" Height="270" Title="!(loc.PSD2LiveRemoveDataDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.PSD2LiveRemoveDataDlgDescription)"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.PSD2LiveRemoveDataDlgTitle)"/>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="ClearData" Type="CheckBox" X="20" Y="60" Width="330" Height="18" Property="PSD2LIVE_CLEAR_DATA" CheckBoxValue="1" Text="!(loc.PSD2LiveRemoveDataDlgCheckBox)"/>
        <Control Id="Details" Type="Text" X="37" Y="82" Width="313" Height="90" Text="!(loc.PSD2LiveRemoveDataDlgDetails)"/>
      </Dialog>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="PSD2LiveRemoveDataDlg" Order="10">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PSD2LiveRemoveDataDlg" Order="10">WixUI_InstallMode = "Remove"</Publish>
    </UI>

    <!-- PSD2Live: deleting the user's data is the app's own job (its clear-user-data option, which leaves it alone while
         the editor runs), done as that user before the files go. PSD2LIVE_CLEAR_DATA=1 asks for it on the
         command line too; a plain uninstall and the uninstall of an upgrade keep the data. WixUI hides Modify in
         Apps & features, the way to the dialog above, so the product is registered with it. -->
    <Property Id="PSD2LIVE_CLEAR_DATA" Secure="yes"/>
    <CustomAction Id="PSD2LiveClearUserData" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]PSD2Live.exe&quot; --clear-user-data"
      Execute="deferred" Impersonate="yes" Return="ignore"/>
    <SetProperty Action="PSD2LiveAllowModify" Id="ARPNOMODIFY" Value="[PSD2LIVE_NO_VALUE]" Before="CostInitialize" Sequence="execute"/>

    <!-- PSD2Live: a running PSD2Live holds the jars in app\ open, which Windows Installer can neither replace
         nor move aside ("Error writing to file ...\app\*.rbf"). Before any file is written or removed, its
         windows are asked to close, as the close button does, so unsaved changes are still offered for saving;
         while it runs on, the installer asks for it to be closed and retries. -->
    <util:CloseApplication Id="PSD2LiveRunning" Target="PSD2Live.exe" CloseMessage="yes" Timeout="20"
      PromptToContinue="yes" Description="!(loc.PSD2LiveCloseAppPrompt)" RebootPrompt="no"/>

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="JpFindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="JpFindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
      <?endif?>
      <!-- PSD2Live: Before="InstallFiles" in the util extension, which is after RemoveFiles; also before the data is
           cleared, which leaves a store an editor holds alone. -->
      <Custom Action="WixCloseApplications" Before="PSD2LiveClearUserData">VersionNT > 400</Custom>
      <Custom Action="PSD2LiveClearUserData" Before="RemoveFiles">REMOVE~="ALL" AND PSD2LIVE_CLEAR_DATA="1" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <RemoveExistingProducts After="InstallExecute"/><!-- PSD2Live: Before="CostInitialize" in jpackage -->
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
    </InstallUISequence>

  </Product>
</Wix>
